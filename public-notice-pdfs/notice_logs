tv\n\n\n\n\n", "files": [{"file_label": "Docket #0475", "file_url": "https://www.boston.gov/sites/default/files/file/2026/07/Hearing%20Order%20Review%20of%20Rule%2015%202026.pdf", "download_success": true, "file_hash": "92aabfa1d0c892cf121ca97d503b158b379cf8db1a7645c3eef94ccdadfcff98"}, {"file_label": "Notice of Accommodations", "file_url": "https://www.boston.gov/sites/default/files/file/2026/07/MG%20COPY_Notice%20of%20Accommodations%20-%20LCA.docx.pdf", "download_success": true, "file_hash": "b50cd31b47ada6b99e1efa51cc15668d9eb9bdbe8e6ea3e75fc11c425fbed2fd"}, {"file_label": "Official Filed Posting", "file_url": "https://www.boston.gov/sites/default/files/file/2026/07/0475%20%28In%20Person%29%20Hearing%208.13.26.docx.pdf", "download_success": true, "file_hash": "37a5dba0b9b66f3b015045daf7ebedea4c87870664112b39557d639a2e2213fc"}], "status": "ok", "checked_at": "2026-08-08T01:31:58.611802+00:00"}
